{
  "name": "equity-research",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev:full": "node scripts/dev-full.mjs",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "data:refresh": "node --env-file-if-exists=.env server/cli.ts refresh",
    "data:import": "node --env-file-if-exists=.env server/cli.ts import",
    "evidence:import": "node --env-file-if-exists=.env server/cli.ts evidence",
    "test:provider": "node --env-file-if-exists=.env server/cli.ts provider",
    "test:performance": "node --env-file-if-exists=.env scripts/performance.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
