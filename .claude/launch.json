{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "research-app",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file-if-exists=.env",
        "server/index.ts"
      ],
      "port": 3001
    },
    {
      "name": "frontend-demo",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5173",
        "--directory",
        "app"
      ],
      "port": 5173
    },
    {
      "name": "vite-sentiment",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "research-app-3003",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file-if-exists=.env",
        "--input-type=module",
        "-e",
        "process.env.PORT='3003'; process.env.DISABLE_REFRESH='1'; const m = await import('./server/index.ts'); m.run();"
      ],
      "port": 3003
    }
  ]
}